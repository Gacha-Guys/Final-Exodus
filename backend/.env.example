FINAL_EXODUS_DB_HOST=your-service-hostname
FINAL_EXODUS_DB_PORT=your-service-port
FINAL_EXODUS_DB_USER=your-app-user
FINAL_EXODUS_DB_PASSWORD=your-private-password
FINAL_EXODUS_DB=Final-Exodus-Database
FINAL_EXODUS_DB_SSL_CA=/absolute/path/to/ca.pem

# Shared profile only works after the additive migration has been applied.
FINAL_EXODUS_STORAGE_PROFILE=shared-users-v1
# Generate a private random signing key of at least 43 characters; do not commit it.
FINAL_EXODUS_JWT_SECRET=replace-with-a-private-random-signing-key
